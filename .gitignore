# ── .gitignore ─────────────────────────────────────────────────────────────
# Do NOT commit datasets, model weights, MLflow runs, caches, or venvs

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Model weights (generated by train.py)
models/*.keras
models/*.pkl
models/*.h5

# MLflow runs (generated artifacts)
artifacts/mlflow/

# Training artifacts
artifacts/*.txt
artifacts/*.png

# Dataset (never commit)
Images/
BanglaLekha-Isolated/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Streamlit
.streamlit/
data_subset_temp/
